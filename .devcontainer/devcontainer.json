{
	"name": "Teleoperation",
	"build": {
		// Path is relative to the devcontainer.json file.
		"dockerfile": "../docker/teleoperation-depthai.Dockerfile",
		"context": "..",
		"args": {
			"USERNAME": "farts",
			"USER_UID": "1000",
			"USER_GID": "1000"
		},
		"containerEnv": {
			"HYDRA_FULL_ERROR": "1"
		},
		"runArgs": [
			"--privileged",
			"-v",
			"/dev/bus/usb:/dev/bus/usb",
			"--device-cgroup-rule='c 189:* rmw'",
			"--network=host",
			"--ipc=host"
		]
	},
